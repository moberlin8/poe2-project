# GitHub secret scanning configuration
# This file configures git-secrets to prevent committing sensitive data

# Patterns to block
BLOCKED_PATTERNS="
# B2 Account IDs (24-char hex starting with 00)
00[0-9a-f]{22}

# B2 App Keys (K followed by 26 chars)
K[0-9A-Za-z]{26}

# API keys with common patterns
[Aa]pi[_-]?[Kk]ey['\"]?\\s*[=:]['\"]\\s*['\"][A-Za-z0-9]{32,}['\"]

# Bearer tokens
[Bb]earer\\s+['\"][A-Za-z0-9._-]{20,}['\"]

# GitHub PATs
gh[pousr]_[A-Za-z0-9]{36,}

# AWS keys
AKIA[0-9A-Z]{16}

# Generic password assignments
[pP]assword['\\\"]?\\s*[:=]\\s*['\\\"][^'\\\"\\s]{4,}['\\\"]

# Zoho SMTP credentials (example: doug****@zohomail.com — never use real address in code)
doug...@zohomail.com
"

# Export blocked patterns for git-secrets
export BLOCKED_PATTERNS
